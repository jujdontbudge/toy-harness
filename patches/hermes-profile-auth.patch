+class CredentialNotSavedError(auth_mod.AuthError):
+    """A user-initiated add did not produce an active-store row."""
+
+
+def claim_profile_pool_on_add(
+    provider: str,
+    borrowed_ids: Optional[Set[str]],
+) -> bool:
+    """Fresh adds claim the active profile; ordinary refreshes do not.
+
+    Decide at write time. An empty borrowed-id set does not distinguish
+    an empty-root borrower from an owning pool.
+    """
+    if borrowed_ids:
+        return True
+    return (
+        provider in SINGLE_USE_REFRESH_POOL_PROVIDERS
+        and auth_mod._global_auth_file_path() is not None
+        and not _profile_owns_pool_provider(provider)
+    )
+
+
+def require_added_credential(
+    provider: str,
+    credential_id: str,
+) -> Dict[str, Any]:
+    """Read the ACTIVE store without root fallback and require the new id."""
+    try:
+        store = auth_mod._load_auth_store()
+        pool = store.get("credential_pool")
+        rows = pool.get(provider) if isinstance(pool, dict) else None
+        if isinstance(rows, list):
+            for row in rows:
+                if isinstance(row, dict) and row.get("id") == credential_id:
+                    return row
+    except Exception:
+        pass
+
+    path = auth_mod._auth_file_path()
+    raise CredentialNotSavedError(
+        f"Credential was not verified in {path}; no successful add was recorded. "
+        "Inspect the active profile store before repeating login.",
+        provider=provider,
+        code="credential_not_saved",
+        relogin_required=False,
+        retryable=False,
+    )
 
 
