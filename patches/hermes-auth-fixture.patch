+def _model_response(request: httpx.Request, asynchronous: bool) -> httpx.Response:
+    global _ACCEPTED_ACCESS_GENERATION
+    observed_generation = next((name for name in _GENERATION_EXPIRATIONS if request.headers.get("authorization") == "Bearer " + _access_token(_GENERATION_EXPIRATIONS[name], name)), None)
+    observe_model = os.environ.get("TOY_AUTH_CONCURRENCY_ACTOR") in {"expired-chat", "fresh-add-reload", "fresh-refresh-reload"}
+    if observe_model:
+        _signal_barrier("model-request-" + (observed_generation or "unknown"))
+    try:
+        payload = json.loads(request.read())
+    except Exception:
+        payload = {}
+    if not isinstance(payload, dict) or payload.get("model") != _EXPECTED_MODEL:
+        if observe_model:
+            _signal_barrier("model-request-model-denied")
+        return _deny_request("model-mismatch")
+    expected_generations = _expected_access_generations()
+    expected_generation = next(
+        (
+            generation
+            for generation in expected_generations
+            if request.headers.get("authorization")
+            == "Bearer " + _access_token(_GENERATION_EXPIRATIONS[generation], generation)
+        ),
+        None,
+    )
+    if expected_generation is None:
+        if observe_model:
+            _signal_barrier("model-request-authorization-denied")
+        return _deny_request("authorization-mismatch")
+    _ACCEPTED_ACCESS_GENERATION = expected_generation
+    if payload.get("stream") is not False:
+        return _event_stream_response(request, asynchronous)
+    return _json_response(
+        request,
+        {
+            "id": "resp_toy_fixture",
+            "object": "response",
+            "created_at": 0,
+            "model": _EXPECTED_MODEL,
+            "status": "completed",
+            "output": [
+                {
+                    "id": "msg_toy_fixture",
+                    "type": "message",
+                    "status": "completed",
+                    "role": "assistant",
+                    "content": [{"type": "output_text", "text": _CHAT_MARKER}],
+                }
+            ],
+            "usage": {"input_tokens": 1, "output_tokens": 1, "total_tokens": 2},
+        },
+        asynchronous,
+    )
+
