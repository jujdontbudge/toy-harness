+def _barrier_path(name: str) -> Path | None:
+    if name not in {"add-response-pending", "release-add-token", "add-command-returned", "release-add-result", "refresh-lock-pending", "release-refresh-lock", "refresh-response-pending", "release-refresh-token", "refresh-catalog-observed", "release-refresh-model", "result-emitted", "release-result", "model-request-initial", "model-request-rotated", "model-request-added", "model-request-added-rotated", "model-request-stale", "model-request-unknown", "model-request-authorization-denied", "model-request-model-denied", "storage-before-replace", "storage-after-replace", "storage-child-identity", "release-storage-cut"}:
+        return None
+    directory = os.environ.get("TOY_AUTH_CONCURRENCY_BARRIER_DIR")
+    if not directory:
+        return None
+    try:
+        root = Path(directory)
+        if root.is_symlink() or not root.is_dir():
+            return None
+        resolved = root.resolve(strict=True)
+        if not resolved.is_dir():
+            return None
+        marker = resolved / name
+        if marker.is_symlink() or marker.exists() and not marker.is_file():
+            return None
+        return marker
+    except OSError:
+        return None
+
+
+def _signal_barrier(name: str) -> bool:
+    marker = _barrier_path(name)
+    if marker is None:
+        return False
+    try:
+        with marker.open("x", encoding="ascii") as handle:
+            handle.write("reached")
+        return True
+    except OSError:
+        return False
+
+
+def _wait_barrier(name: str, timeout_seconds: float = 45.0) -> bool:
+    marker = _barrier_path(name)
+    if marker is None:
+        return False
+    deadline = time.monotonic() + timeout_seconds
+    while time.monotonic() < deadline:
+        if marker.exists() and marker.is_file() and not marker.is_symlink():
+            return True
+        time.sleep(0.01)
+    return marker.exists() and marker.is_file() and not marker.is_symlink()
+
+
+def _concurrency_result(operation: str) -> dict[str, object] | None:
+    order = os.environ.get("TOY_AUTH_CONCURRENCY_ORDER", "")
+    actor = os.environ.get("TOY_AUTH_CONCURRENCY_ACTOR", "")
+    if order not in {"refresh-first", "add-first"} or actor not in {"auth-add", "expired-chat", "fresh-list-reload", "fresh-add-reload", "fresh-refresh-reload"}:
+        return None
+    fresh_use = "not-checked"
+    if actor in {"fresh-add-reload", "fresh-refresh-reload"} and operation == "chat":
+        fresh_use = "usable" if operation == "chat" and _ACCEPTED_ACCESS_GENERATION is not None else "unusable"
+    return {
+        "order": order,
+        "actor": actor,
+        "barrier": _CONCURRENCY_BARRIER_STATE,
+        "crashCut": os.environ.get("TOY_AUTH_CONCURRENCY_CRASH_CUT", "none"),
+        "staleRefreshTokenRejected": "not-exercised",
+        "staleRefreshResponse": "not-exercised",
+        "freshProcessUse": fresh_use,
+        "refreshGeneration": _ACCEPTED_ACCESS_GENERATION,
+        "refreshEffects": list(_REFRESH_EFFECTS),
+    }
+
