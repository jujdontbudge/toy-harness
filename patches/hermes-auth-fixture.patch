+def _fixture_label() -> str:
+    return "toy-fixture-storage-cut" if os.environ.get("TOY_AUTH_STORAGE_CONTEXT") == "1" else "toy-fixture-added-" + os.environ.get("TOY_AUTH_CONCURRENCY_ORDER", "")
+
