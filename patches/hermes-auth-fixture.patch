+def _access_token(expiration: int, generation: str = "initial") -> str:
+    header = base64.urlsafe_b64encode(b'{"alg":"none","typ":"JWT"}').rstrip(b"=").decode()
+    claims = {
+        "exp": expiration,
+        "sub": f"toy-fixture-{generation}",
+        "https://api.openai.com/auth": {"chatgpt_account_id": f"toy-fixture-account-{generation}"},
+    }
+    payload = base64.urlsafe_b64encode(
+        json.dumps(claims, separators=(",", ":")).encode()
+    ).rstrip(b"=").decode()
+    return f"{header}.{payload}.fixture"
+
+
+def _expected_access_generations() -> tuple[str, ...]:
+    actor = os.environ.get("TOY_AUTH_CONCURRENCY_ACTOR", "")
+    if actor == "fresh-add-reload":
+        return ("added-rotated",)
+    if actor == "fresh-refresh-reload":
+        return ("rotated",) if os.environ.get("TOY_AUTH_CONCURRENCY_ORDER") == "add-first" else ("stale",)
+    if _PHASE == "chat-expired" and actor == "expired-chat":
+        order = os.environ.get("TOY_AUTH_CONCURRENCY_ORDER")
+        if order == "add-first":
+            return ("rotated",)
+        if order == "refresh-first":
+            return ("stale",)
+        return ("rotated", "added-rotated")
+    if _PHASE == "chat":
+        return ("initial",)
+    if _PHASE in {"chat-expired", "chat-reloaded"}:
+        return ("rotated", "stale", "added-rotated")
+    return ()
+
