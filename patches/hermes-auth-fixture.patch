+_GENERATION_REFRESH_TOKENS = {"initial": "toy-fixture-refresh-initial", "rotated": "toy-fixture-refresh-rotated", "added": "toy-fixture-refresh-added", "added-rotated": "toy-fixture-refresh-added-rotated", "stale": "toy-fixture-refresh-stale"}
