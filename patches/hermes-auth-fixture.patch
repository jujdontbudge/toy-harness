+def _public_argv(operation: str) -> list[str]:
+    prefix = ["hermes", "--profile", "toy"]
+    if operation == "add":
+        label = ["--label", _fixture_label()] if os.environ.get("TOY_AUTH_CONCURRENCY_ACTOR") == "auth-add" else []
+        return [*prefix, "auth", "add", "openai-codex", "--type", "oauth", "--no-browser", *label]
+    if operation == "list":
+        return [*prefix, "auth", "list", "openai-codex"]
+    if operation == "priority":
+        target = _fixture_label() if _PHASE == "priority-added" else "2"
+        return [*prefix, "auth", "priority", "openai-codex", target, "0"]
+    provider = "siwc_responses" if _PHASE == "siwc-unbound" else "openai-codex"
+    return [*prefix, "chat", "--provider", provider, "--model", _EXPECTED_MODEL, "--toolsets", "none", "-q", _PROMPT]
+
