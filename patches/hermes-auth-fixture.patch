+def _response(
+    request: httpx.Request,
+    content: bytes,
+    content_type: str,
+    asynchronous: bool,
+    status_code: int = 200,
+) -> httpx.Response:
+    headers = {"content-type": content_type}
+    if asynchronous:
+        return httpx.Response(
+            status_code,
+            headers=headers,
+            stream=_FixtureAsyncStream(content),
+            request=request,
+        )
+    return httpx.Response(status_code, headers=headers, content=content, request=request)
+
+
+def _json_response(
+    request: httpx.Request,
+    value: dict[str, object],
+    asynchronous: bool,
+) -> httpx.Response:
+    content = json.dumps(value, separators=(",", ":")).encode()
+    return _response(request, content, "application/json", asynchronous)
+
+
+def _event_stream_response(request: httpx.Request, asynchronous: bool) -> httpx.Response:
+    events = (
+        (
+            "response.output_text.delta",
+            {"type": "response.output_text.delta", "delta": _CHAT_MARKER},
+        ),
+        (
+            "response.completed",
+            {
+                "type": "response.completed",
+                "response": {
+                    "id": "resp_toy_fixture",
+                    "status": "completed",
+                    "usage": {
+                        "input_tokens": 1,
+                        "output_tokens": 1,
+                        "total_tokens": 2,
+                    },
+                },
+            },
+        ),
+    )
+    body = "".join(
+        f"event: {name}\ndata: {json.dumps(value, separators=(',', ':'))}\n\n"
+        for name, value in events
+    ).encode()
+    return _response(request, body, "text/event-stream", asynchronous)
+
