+def _run_cli(argv: list[str]) -> tuple[int, str, str, str]:
+    saved_argv = sys.argv
+    saved_stdout, saved_stderr = sys.stdout, sys.stderr
+    captured_stdout, captured_stderr = io.StringIO(), io.StringIO()
+    result = 0
+    failure = ""
+    try:
+        sys.argv = argv[:]
+        sys.stdout, sys.stderr = captured_stdout, captured_stderr
+        from hermes_cli.main import main as hermes_main
+
+        hermes_main()
+    except SystemExit as exc:
+        result = exc.code if isinstance(exc.code, int) else 1
+        if exc.code is not None and not isinstance(exc.code, int):
+            print(exc.code, file=captured_stderr)
+        if result:
+            failure = "CLI_EXIT_NONZERO"
+    except Exception:
+        traceback.print_exc(file=captured_stderr)
+        result = 1
+        failure = "CLI_EXCEPTION"
+    finally:
+        sys.argv = saved_argv
+        sys.stdout, sys.stderr = saved_stdout, saved_stderr
+    return result, captured_stdout.getvalue(), captured_stderr.getvalue(), failure
+
+
+def _hold_refresh_lock() -> None:
+    if os.environ.get("TOY_AUTH_CONCURRENCY_ORDER") != "add-first" or os.environ.get("TOY_AUTH_CONCURRENCY_ACTOR") != "expired-chat":
+        return
+    original_flock = fcntl.flock
+    held = False
+
+    def flock(fd: int, operation: int) -> None:
+        nonlocal held
+        if not held and operation & fcntl.LOCK_EX:
+            held = True
+            if not _signal_barrier("refresh-lock-pending") or not _wait_barrier("release-refresh-lock"):
+                raise TimeoutError("Fixture OS lock barrier was not released.")
+        original_flock(fd, operation)
+
+    fcntl.flock = flock
+
+
+def _safe_result(
+    operation: str,
+    argv: list[str],
+    exit_code: int,
+    stdout: str,
+    stderr: str,
+    failure: str,
+) -> dict[str, object]:
+    markers: list[str] = []
+    combined_output = stdout + "\n" + stderr
+    tokens = tuple(
+        _access_token(expiration, generation)
+        for generation, expiration in _GENERATION_EXPIRATIONS.items()
+    ) + tuple(_GENERATION_REFRESH_TOKENS.values()) + (_PAID_KEY,)
+    token_hygiene = not any(token in combined_output for token in tokens)
+    lower_output = combined_output.casefold()
+    fallback_attempted = any(
+        claim in lower_output
+        for claim in ("falling through to fallback:", "switching to fallback", "falling back to ")
+    )
+    success_claim_absent = not any(
+        claim in lower_output
+        for claim in (
+            "added openai-codex oauth credential",
+            "login successful",
+            "authentication successful",
+            "authenticated successfully",
+            "oauth credential added",
+        )
+    )
+    observations: dict[str, object] = {
+        "provider": "openai-chatgpt" if _PHASE == "siwc-unbound" else "openai-codex",
+        "phase": _PHASE,
+        "access_generation": _ACCEPTED_ACCESS_GENERATION,
+        "catalog_access_generation": _CATALOG_ACCESS_GENERATION,
+        "network_denials": list(_DENIALS),
+        "socket_origin": _SOCKET_ORIGIN,
+        "storage_fault_triggered": _STORAGE_FAULT_TRIGGERED,
+        "token_hygiene": token_hygiene,
+        "success_claim_absent": success_claim_absent,
+        "fallback_attempted": fallback_attempted,
+    }
+    if operation == "add":
+        if _PHASE in {"add-enospc", "add-replace-fault"}:
+            save_denied = exit_code != 0 and _STORAGE_FAULT_TRIGGERED and token_hygiene and success_claim_absent
+            markers.append("AUTH_SAVE_DENIED" if save_denied else "AUTH_SAVE_FAULT_NOT_CONFIRMED")
+        else:
+            added = exit_code == 0 and "Added openai-codex OAuth credential #" in combined_output
+            markers.append("AUTH_ADD_OK" if added else "AUTH_ADD_NOT_CONFIRMED")
+    elif operation == "priority":
+        expected_label = _fixture_label()
+        label_matches = _PHASE != "priority-added" or f'Set openai-codex credential "{expected_label}" to priority 0 (#1' in stdout
+        moved = exit_code == 0 and label_matches and "Set openai-codex credential" in stdout and "to priority 0 (#1" in stdout
+        markers.append("AUTH_PRIORITY_OK" if moved else "AUTH_PRIORITY_NOT_CONFIRMED")
+    elif operation == "list":
+        count = 0
+        for line in stdout.splitlines():
+            if line.startswith("openai-codex (") and line.endswith(" credentials):"):
+                raw = line[len("openai-codex (") : -len(" credentials):")]
+                if raw.isdecimal():
+                    count = int(raw)
+                    break
+        observations["credential_count"] = count
+        if os.environ.get("TOY_AUTH_STORAGE_CONTEXT") == "1":
+            observations["target_label_present"] = _fixture_label() in stdout
+        markers.append("AUTH_LIST_READBACK_OK" if count > 0 else "AUTH_LIST_EMPTY")
+    else:
+        if _PHASE == "siwc-unbound":
+            refused = (
+                exit_code != 0
+                and "Independent ChatGPT plan authorization is required." in combined_output
+                and _CHAT_MARKER not in combined_output
+                and all(count == 0 for count in _COUNTS.values())
+                and token_hygiene
+                and success_claim_absent
+                and not fallback_attempted
+            )
+            markers.append("SIWC_AUTHORIZATION_REQUIRED" if refused else "SIWC_AUTHORIZATION_NOT_CONFIRMED")
+        elif _PHASE == "chat-after-fault":
+            request_total = sum(
+                _COUNTS[key]
+                for key in (
+                    "device_code_requests",
+                    "device_code_polls",
+                    "token_exchanges",
+                    "token_refreshes",
+                    "model_catalog_requests",
+                    "model_requests",
+                )
+            )
+            unusable = exit_code != 0 and _CHAT_MARKER not in combined_output and request_total == 0
+            markers.append("CHAT_GRANT_UNUSABLE" if unusable else "CHAT_GRANT_USABILITY_NOT_CONFIRMED")
+        else:
+            replied = exit_code == 0 and _CHAT_MARKER in combined_output
+            markers.append("CHAT_RESPONSE_OK" if replied else "CHAT_RESPONSE_NOT_CONFIRMED")
+    if failure:
+        markers.append(failure)
+    result: dict[str, object] = {
+        "schema": "toy.hermes-httpx-auth-fixture.v1",
+        "operation": operation,
+        "public_argv": argv,
+        "exit_code": exit_code,
+        "markers": markers,
+        "processIdentity": {"pid": os.getpid(), "parentPid": os.getppid(), "uid": os.getuid(), "gid": os.getgid()},
+        "observations": observations,
+        "http_ledger": dict(_COUNTS),
+        "network_audit": "socket-audit-hook-installed",
+    }
+    concurrency = _concurrency_result(operation)
+    if concurrency is not None:
+        result["concurrency"] = concurrency
+    return result
+
+
+def main() -> int:
+    global _OPERATION, _PHASE, _CONCURRENCY_BARRIER_STATE
+    if len(sys.argv) != 2 or sys.argv[1] not in {"add", "list", "chat", "chat-expired", "chat-reloaded", "add-enospc", "add-replace-fault", "list-after-fault", "chat-after-fault", "siwc-unbound", "priority-added", "priority-restored"}:
+        print(
+            json.dumps(
+                {
+                    "schema": "toy.hermes-httpx-auth-fixture.v1",
+                    "operation": "invalid",
+                    "exit_code": 2,
+                    "markers": ["INVALID_FIXTURE_OPERATION"],
+                },
+                sort_keys=True,
+            )
+        )
+        return 2
+    _PHASE = sys.argv[1]
+    _OPERATION = {
+        "add-enospc": "add",
+        "add-replace-fault": "add",
+        "list-after-fault": "list",
+        "chat-after-fault": "chat",
+        "siwc-unbound": "chat",
+        "priority-added": "priority",
+        "priority-restored": "priority",
+    }.get(_PHASE, "chat" if _PHASE.startswith("chat") else _PHASE)
+    if _PHASE == "siwc-unbound":
+        os.environ["OPENAI_API_KEY"] = _PAID_KEY
+    if _PHASE == "chat-expired":
+        time.time = lambda: 4102448400.0 if os.environ.get("TOY_AUTH_CONCURRENCY_ORDER") == "refresh-first" else 1893463200.0
+    if os.environ.get("TOY_AUTH_CONCURRENCY_ACTOR") == "fresh-add-reload" and _PHASE == "chat-reloaded":
+        time.time = lambda: 1893466800.0
+    argv = _public_argv(_OPERATION)
+    httpx.Client.send = _sync_send
+    httpx.AsyncClient.send = _async_send
+    sys.addaudithook(_deny_socket)
+    _install_storage_replace_cut()
+    _hold_refresh_lock()
+    exit_code, stdout, stderr, failure = _run_cli(argv)
+    if os.environ.get("TOY_AUTH_CONCURRENCY_ACTOR") == "auth-add":
+        if _signal_barrier("add-command-returned"):
+            _CONCURRENCY_BARRIER_STATE = "reached"
+            if _wait_barrier("release-add-result"):
+                _CONCURRENCY_BARRIER_STATE = "released"
+            else:
+                exit_code = 1
+                failure = "CLI_EXIT_NONZERO"
+    result = _safe_result(_OPERATION, argv, exit_code, stdout, stderr, failure)
+    print(json.dumps(result, sort_keys=True), flush=True)
+    actor = os.environ.get("TOY_AUTH_CONCURRENCY_ACTOR", "")
+    if actor in {"auth-add", "expired-chat"} and os.environ.get("TOY_AUTH_CONCURRENCY_HOLD_AFTER_RESULT") == "1":
+        if _signal_barrier("result-emitted"):
+            _wait_barrier("release-result")
+    return exit_code
+
