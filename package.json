{
  "name": "toy-harness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.21.0", "npm": "11.19.0" },
  "workspaces": ["packages/*", "cli"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "boundaries": "depcruise --config .dependency-cruiser.cjs packages cli",
    "python:check": "pyright && .venv/bin/ruff check python && PYTHONPATH=python .venv/bin/lint-imports",
    "check": "npm run typecheck && npm run boundaries && npm run python:check",
    "check:foundations": "node scripts/check-foundations.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "pyright": "1.1.414",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
