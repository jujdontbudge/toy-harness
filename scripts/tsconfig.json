{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "sourceMap": false
  },
  "include": [
    "../packages/**/*.js",
    "../packages/**/*.jsx",
    "../packages/**/*.mjs",
    "../cli/**/*.js",
    "../cli/**/*.jsx",
    "../cli/**/*.mjs",
    "../plugins/toy/**/*.js",
    "../plugins/toy/**/*.mjs",
    "../behavior/**/*.js",
    "../behavior/**/*.mjs",
    "../tests/**/*.js",
    "../tests/**/*.mjs",
    "../scripts/**/*.js",
    "../scripts/**/*.jsx",
    "../scripts/**/*.mjs",
    "../eslint.config.mjs",
    "../scripts/**/*.mts",
    "../packages/ops/src/pg-boss-published-types.d.ts"
  ],
  "exclude": [
    "../node_modules",
    "../build",
    "../.venv"
  ]
}
