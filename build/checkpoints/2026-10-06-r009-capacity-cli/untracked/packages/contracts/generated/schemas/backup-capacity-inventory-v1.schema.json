{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "observedAt": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "dataFilesystemPath": {
      "type": "string",
      "const": "/System/Volumes/Data"
    },
    "primaryTotalBytes": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "primaryAvailableBytes": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "externalPhysicalDiskCount": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "localCapacityState": {
      "type": "string",
      "enum": [
        "measured",
        "unavailable"
      ]
    },
    "externalMetadataState": {
      "type": "string",
      "enum": [
        "measured",
        "unavailable"
      ]
    },
    "independentDestinationCapacityVerified": {
      "type": "boolean",
      "const": false
    },
    "remoteAccountInspected": {
      "type": "boolean",
      "const": false
    },
    "restoreVerified": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "observedAt",
    "dataFilesystemPath",
    "primaryTotalBytes",
    "primaryAvailableBytes",
    "externalPhysicalDiskCount",
    "localCapacityState",
    "externalMetadataState",
    "independentDestinationCapacityVerified",
    "remoteAccountInspected",
    "restoreVerified"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:BackupCapacityInventoryV1"
}
