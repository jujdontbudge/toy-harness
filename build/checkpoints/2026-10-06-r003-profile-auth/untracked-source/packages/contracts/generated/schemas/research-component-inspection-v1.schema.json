{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][0-9]{2}(?![\\s\\S])"
    },
    "sourceLine": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "rowDigest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "componentAndPin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "consumingSpecs": {
      "type": "string",
      "maxLength": 16000
    },
    "researchReference": {
      "type": "string",
      "maxLength": 16000
    },
    "alternativesAndReason": {
      "type": "string",
      "maxLength": 16000
    },
    "releaseGate": {
      "type": "string",
      "maxLength": 16000
    },
    "missingPinDeclared": {
      "type": "boolean"
    },
    "reportKeys": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 10
      }
    },
    "certification": {
      "type": "string",
      "const": "UNVERIFIED"
    }
  },
  "required": [
    "id",
    "sourceLine",
    "rowDigest",
    "componentAndPin",
    "consumingSpecs",
    "researchReference",
    "alternativesAndReason",
    "releaseGate",
    "missingPinDeclared",
    "reportKeys",
    "certification"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:ResearchComponentInspectionV1"
}
