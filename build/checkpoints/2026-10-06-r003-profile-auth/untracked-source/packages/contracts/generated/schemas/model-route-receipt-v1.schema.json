{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requested": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "foreground",
            "background",
            "cron",
            "auxiliary",
            "continuation",
            "research",
            "child"
          ]
        },
        "arm": {
          "type": "string",
          "enum": [
            "original",
            "experimental-background-high-standard"
          ]
        },
        "provider": {
          "type": "string",
          "const": "siwc_responses"
        },
        "settings": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "enum": [
                "gpt-6.1-sol",
                "gpt-6-luna"
              ]
            },
            "effort": {
              "type": "string",
              "enum": [
                "max",
                "medium",
                "high"
              ]
            },
            "serviceTier": {
              "type": "string",
              "enum": [
                "priority",
                "default"
              ]
            }
          },
          "required": [
            "model",
            "effort",
            "serviceTier"
          ],
          "additionalProperties": false
        },
        "policyDigest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "localOutputReservationTokens": {
          "type": "number",
          "const": 4096
        },
        "outputLimitKind": {
          "type": "string",
          "const": "estimate"
        },
        "providerOutputCap": {
          "type": "null"
        },
        "paidFallbackPermitted": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "role",
        "arm",
        "provider",
        "settings",
        "policyDigest",
        "localOutputReservationTokens",
        "outputLimitKind",
        "providerOutputCap",
        "paidFallbackPermitted"
      ],
      "additionalProperties": false
    },
    "observed": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "enum": [
                "gpt-6.1-sol",
                "gpt-6-luna"
              ]
            },
            "effort": {
              "type": "string",
              "enum": [
                "max",
                "medium",
                "high"
              ]
            },
            "serviceTier": {
              "type": "string",
              "enum": [
                "priority",
                "default"
              ]
            }
          },
          "required": [
            "model",
            "effort",
            "serviceTier"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "terminal": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "interrupted"
      ]
    },
    "completion": {
      "type": "string",
      "enum": [
        "complete",
        "pending"
      ]
    },
    "usage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "inputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reasoningTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "inputTokens",
            "outputTokens",
            "reasoningTokens"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "usageState": {
      "type": "string",
      "enum": [
        "known",
        "uncertain"
      ]
    },
    "reservationTokens": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 4096
        }
      ]
    },
    "outputStarted": {
      "type": "boolean"
    },
    "reasonCode": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "quota_exhausted",
            "authentication_unavailable",
            "provider_failed",
            "protocol_invalid",
            "route_mismatch",
            "route_unobserved",
            "usage_unavailable",
            "stream_interrupted"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "paidFallbackAttempted": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "requested",
    "observed",
    "terminal",
    "completion",
    "usage",
    "usageState",
    "reservationTokens",
    "outputStarted",
    "reasonCode",
    "paidFallbackAttempted"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:ModelRouteReceiptV1"
}
