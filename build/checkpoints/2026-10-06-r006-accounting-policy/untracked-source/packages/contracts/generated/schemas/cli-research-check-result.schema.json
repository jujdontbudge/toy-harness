{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "toy.cli.v1"
    },
    "commandId": {
      "type": "string",
      "const": "research.check"
    },
    "invocationId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "cliVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "contractsVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "schemaDigest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "environment": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "prod",
            "test"
          ]
        },
        "instanceId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "stackId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "instanceId",
        "stackId"
      ],
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "exitCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 143
        },
        "releaseDigest": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "controlDigest": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "evaluatedAt": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 24,
              "maxLength": 24,
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "operationId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "effectState": {
          "type": "string",
          "enum": [
            "none",
            "confirmed",
            "unknown"
          ]
        },
        "recordRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "id": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "required": [
              "module",
              "kind",
              "id"
            ],
            "additionalProperties": false
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "observationRef": {
                "type": "string",
                "minLength": 55,
                "maxLength": 55,
                "pattern": "^life:\\/\\/observation\\/([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "documentId": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "byteFrom": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
              },
              "byteTo": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
              },
              "quote": {
                "type": "string"
              }
            },
            "required": [
              "observationRef"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "exitCode",
        "releaseDigest",
        "controlDigest",
        "evaluatedAt",
        "operationId",
        "effectState",
        "recordRefs",
        "evidence"
      ],
      "additionalProperties": false
    },
    "ok": {
      "type": "boolean",
      "const": true
    },
    "data": {
      "type": "object",
      "properties": {
        "requestedRelease": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "R0",
                "R1",
                "R2",
                "R3",
                "R4",
                "R5"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "registerPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*(?![\\s\\S])"
        },
        "registerDigest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "components": {
          "minItems": 1,
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Z][0-9]{2}(?![\\s\\S])"
              },
              "sourceLine": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "rowDigest": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
              },
              "componentAndPin": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              },
              "consumingSpecs": {
                "type": "string",
                "maxLength": 16000
              },
              "researchReference": {
                "type": "string",
                "maxLength": 16000
              },
              "alternativesAndReason": {
                "type": "string",
                "maxLength": 16000
              },
              "releaseGate": {
                "type": "string",
                "maxLength": 16000
              },
              "missingPinDeclared": {
                "type": "boolean"
              },
              "reportKeys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 10
                }
              },
              "certification": {
                "type": "string",
                "const": "UNVERIFIED"
              }
            },
            "required": [
              "id",
              "sourceLine",
              "rowDigest",
              "componentAndPin",
              "consumingSpecs",
              "researchReference",
              "alternativesAndReason",
              "releaseGate",
              "missingPinDeclared",
              "reportKeys",
              "certification"
            ],
            "additionalProperties": false
          }
        },
        "reports": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "maxLength": 10
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*(?![\\s\\S])"
              },
              "listedSections": {
                "type": "string",
                "maxLength": 16000
              },
              "digest": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64,
                    "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "key",
              "path",
              "listedSections",
              "digest"
            ],
            "additionalProperties": false
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "componentId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Z][0-9]{2}(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "code": {
                "type": "string",
                "enum": [
                  "PIN_MISSING",
                  "CONSUMING_SPECS_MISSING",
                  "RESEARCH_CHOICE_OPEN",
                  "RESEARCH_REFERENCE_MISSING",
                  "REPORT_MISSING",
                  "DECISION_MISSING",
                  "GATE_MISSING",
                  "GATE_EVIDENCE_UNVERIFIED",
                  "RESEARCH_ATTESTATION_UNVERIFIED",
                  "DEPENDENCY_CLOSURE_UNVERIFIED"
                ]
              },
              "sourceLine": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "componentId",
              "code",
              "sourceLine"
            ],
            "additionalProperties": false
          }
        },
        "scope": {
          "type": "string",
          "const": "register_inventory"
        },
        "admission": {
          "type": "string",
          "const": "BLOCKED"
        },
        "acceptanceComplete": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "requestedRelease",
        "registerPath",
        "registerDigest",
        "components",
        "reports",
        "findings",
        "scope",
        "admission",
        "acceptanceComplete"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "commandId",
    "invocationId",
    "generatedAt",
    "cliVersion",
    "contractsVersion",
    "schemaDigest",
    "environment",
    "meta",
    "ok",
    "data"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:CliResearchCheckResult"
}
