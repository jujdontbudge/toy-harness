{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "iss": {
      "type": "string",
      "const": "https://auth.openai.com"
    },
    "sub": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "aud": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      ]
    },
    "exp": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "iat": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "nbf": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nonce": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "azp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "required": [
    "iss",
    "sub",
    "aud",
    "exp",
    "iat",
    "nonce"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:SiwcIdentityClaimsV1"
}
