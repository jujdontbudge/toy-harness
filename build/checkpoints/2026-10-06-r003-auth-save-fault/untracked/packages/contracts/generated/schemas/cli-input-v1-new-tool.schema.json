{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "connector",
        "tool",
        "skill",
        "migration"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
    },
    "owner": {
      "type": "string",
      "enum": [
        "contracts",
        "obligations",
        "attention",
        "authority",
        "sources",
        "lifestore",
        "hermes",
        "client",
        "hands",
        "self-improvement",
        "adhd",
        "ops"
      ]
    },
    "provider": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "operation": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "plan": {
      "type": "boolean"
    }
  },
  "required": [
    "kind",
    "name",
    "owner",
    "provider",
    "operation",
    "plan"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:CliInputV1:new.tool"
}
