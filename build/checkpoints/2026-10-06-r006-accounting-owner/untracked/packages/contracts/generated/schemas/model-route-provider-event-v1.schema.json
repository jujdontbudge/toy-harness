{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "route"
        },
        "settings": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "enum": [
                "gpt-6.1-sol",
                "gpt-6-luna"
              ]
            },
            "effort": {
              "type": "string",
              "enum": [
                "max",
                "medium",
                "high"
              ]
            },
            "serviceTier": {
              "type": "string",
              "enum": [
                "priority",
                "default"
              ]
            }
          },
          "required": [
            "model",
            "effort",
            "serviceTier"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "settings"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "output"
        },
        "text": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "tool-call"
        },
        "callId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "argumentsJson": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "required": [
        "type",
        "callId",
        "name",
        "argumentsJson"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "usage"
        },
        "usage": {
          "type": "object",
          "properties": {
            "inputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reasoningTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "inputTokens",
            "outputTokens",
            "reasoningTokens"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "usage"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "completed"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "failed"
        },
        "code": {
          "type": "string",
          "enum": [
            "quota_exhausted",
            "authentication_unavailable",
            "provider_failed",
            "protocol_invalid"
          ]
        }
      },
      "required": [
        "type",
        "code"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "interrupted"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "urn:toy:contracts:v1:ModelRouteProviderEventV1"
}
