{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "callId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "nativeTerminalAcknowledged": {
          "type": "boolean"
        },
        "usage": {
          "type": "object",
          "properties": {
            "inputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reasoningTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "inputTokens",
            "outputTokens",
            "reasoningTokens"
          ],
          "additionalProperties": false
        },
        "reportedTotalTokens": {
          "type": "string",
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
        }
      },
      "required": [
        "callId",
        "nativeTerminalAcknowledged",
        "usage",
        "reportedTotalTokens"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "callId": {
          "type": "string",
