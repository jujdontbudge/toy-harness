{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "readmePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*(?![\\s\\S])"
    },
    "readmeDigest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "opsSpecPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*(?![\\s\\S])"
    },
    "opsSpecDigest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "components": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "componentId": {
            "type": "string",
            "pattern": "^[A-Z][0-9]{2}(?![\\s\\S])"
          },
          "sourceLines": {
            "minItems": 1,
            "maxItems": 16000,
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "requirementIds": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+(?![\\s\\S])"
            }
          }
        },
        "required": [
          "componentId",
          "sourceLines",
          "requirementIds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "readmePath",
    "readmeDigest",
    "opsSpecPath",
    "opsSpecDigest",
    "components"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:ResearchOpsRequirementScopeV1"
}
