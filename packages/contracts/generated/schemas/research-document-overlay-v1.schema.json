{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reportKey": {
      "type": "string",
      "pattern": "^[A-Z]{1,10}(?![\\s\\S])"
    },
    "originalDigest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "contentDigest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "markdown": {
      "type": "string",
      "maxLength": 2097152
    }
  },
  "required": [
    "reportKey",
    "originalDigest",
    "contentDigest",
    "markdown"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:ResearchDocumentOverlayV1"
}
