{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*(?![\\s\\S])"
    },
    "digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "componentReferences": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[ABNCEDM][0-9]{2}(?![\\s\\S])"
          },
          "sourceLines": {
            "minItems": 1,
            "maxItems": 16000,
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "required": [
          "id",
          "sourceLines"
        ],
        "additionalProperties": false
      }
    },
    "requirementMappingRows": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceLine": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "rowDigest": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "requirementCell": {
            "type": "string",
            "maxLength": 16000
          }
        },
        "required": [
          "sourceLine",
          "rowDigest",
          "requirementCell"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "path",
    "digest",
    "componentReferences",
    "requirementMappingRows"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:ResearchSpecReferencesV1"
}
