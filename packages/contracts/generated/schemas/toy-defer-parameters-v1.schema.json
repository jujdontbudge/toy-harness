                },
                "amount": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 315360000
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "seconds",
                    "minutes",
                    "hours",
                    "calendar_days",
                    "business_days"
