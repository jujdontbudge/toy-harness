                },
                "time": {
                  "type": "string",
                  "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$"
                },
                "timezone": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "disambiguation": {
                  "type": "string",
                  "enum": [
                    "earlier",
                    "later",
                    "reject"
