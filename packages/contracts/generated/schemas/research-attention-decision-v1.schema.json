{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "const": "attention-research-decision"
    },
    "componentId": {
      "type": "string",
      "const": "M02"
    },
    "mappedRequirements": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "options": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "tool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "example": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "viable": {
            "type": "boolean"
          },
          "support": {
            "type": "string",
            "enum": [
              "proven",
              "unsupported",
              "unknown"
            ]
          },
          "primaryEvidenceIds": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "reliability": {
            "type": "string",
            "maxLength": 2000
          },
          "maintenance": {
            "type": "string",
            "maxLength": 2000
          },
          "resources": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "tool",
          "example",
          "viable",
          "support",
          "primaryEvidenceIds",
          "reliability",
          "maintenance",
          "resources"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "primary",
              "secondary"
            ]
          },
          "supportedOptionIds": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        },
        "required": [
          "id",
          "url",
          "publisher",
          "kind",
          "supportedOptionIds"
        ],
        "additionalProperties": false
      }
    },
    "selectedOptionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "unresolvedFacts": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "optionId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "fact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "optionId",
          "fact"
        ],
        "additionalProperties": false
      }
    },
    "acceptanceIds": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AT-[A-Za-z0-9-]+(?![\\s\\S])"
      }
    },
    "validationPlan": {
      "type": "string",
      "maxLength": 4000
    },
    "releaseGate": {
      "type": "string",
      "maxLength": 16000
    },
    "validations": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "support": {
            "type": "string",
            "enum": [
              "proven",
              "unsupported",
              "unknown"
            ]
          },
          "sourceIds": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "testIds": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AT-[A-Za-z0-9-]+(?![\\s\\S])"
            }
          }
        },
        "required": [
          "id",
          "support",
          "sourceIds",
          "testIds"
        ],
        "additionalProperties": false
      }
    },
    "decisionId": {
      "type": "string",
      "enum": [
        "discord-delivery",
        "push-delivery",
        "alarm-delivery",
        "reminder-scheduling"
      ]
    },
    "executionReceipt": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "purpose": {
              "type": "string",
              "enum": [
                "research",
                "implementation"
              ]
            },
            "executionBackend": {
              "type": "string",
              "const": "codex_exec"
            },
            "state": {
              "type": "string",
              "enum": [
                "observed",
                "refused"
              ]
            },
            "reasonCode": {
              "type": "string",
              "enum": [
                "DELEGATION_ROUTE_OBSERVED",
                "DELEGATION_ROUTE_REFUSED",
                "DELEGATION_RESULT_REFUSED",
                "RESEARCH_SKILL_UNAVAILABLE",
                "RESEARCH_SKILL_MISMATCH"
              ]
            },
            "skill": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "repository": {
                      "type": "string",
                      "const": "https://github.com/mattpocock/skills"
                    },
                    "sourcePath": {
                      "type": "string",
                      "const": "skills/engineering/research/SKILL.md"
                    },
                    "sourceCommit": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}(?![\\s\\S])"
                    },
                    "contentDigest": {
                      "type": "string",
                      "minLength": 64,
                      "maxLength": 64,
                      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                    },
                    "loadedDigest": {
                      "type": "string",
                      "minLength": 64,
                      "maxLength": 64,
                      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                    },
                    "semanticVersion": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "resources": {
                      "minItems": 2,
                      "maxItems": 2,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string",
                            "enum": [
                              "LICENSE",
                              "agents/openai.yaml"
                            ]
                          },
                          "digest": {
                            "type": "string",
                            "minLength": 64,
                            "maxLength": 64,
                            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                          }
                        },
                        "required": [
                          "path",
                          "digest"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "repository",
                    "sourcePath",
                    "sourceCommit",
                    "contentDigest",
                    "loadedDigest",
                    "semanticVersion",
                    "resources"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "invocation": {
