                              "type": "string",
                              "const": "original"
                            },
                            "provider": {
                              "type": "string",
                              "const": "siwc_responses"
                            },
                            "settings": {
                              "type": "object",
                              "properties": {
                                "model": {
                                  "type": "string",
                                  "const": "gpt-6.1-sol"
                                },
                                "effort": {
                                  "type": "string",
                                  "const": "max"
                                },
                                "serviceTier": {
                                  "type": "string",
                                  "const": "priority"
                                }
                              },
                              "required": [
                                "model",
                                "effort",
                                "serviceTier"
                              ],
                              "additionalProperties": false
                            },
                            "policyDigest": {
                              "type": "string",
