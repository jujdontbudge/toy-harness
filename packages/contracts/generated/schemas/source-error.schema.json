{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "AUTH_REQUIRED",
        "CONSENT_REQUIRED",
        "POLICY_BLOCKED",
        "OS_PERMISSION_REQUIRED",
        "ACCOUNT_MISMATCH",
        "CURSOR_EXPIRED",
        "RATE_LIMITED",
        "QUOTA_EXHAUSTED",
        "PAYMENT_REQUIRED",
        "NETWORK_UNAVAILABLE",
        "PROVIDER_UNAVAILABLE",
        "SCHEMA_CHANGED",
        "MALFORMED_ITEM",
        "COVERAGE_INCOMPLETE",
        "STORAGE_PRESSURE",
        "LEASE_LOST",
        "IDENTITY_CONFLICT",
        "INVALID_INPUT"
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "retryAt": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "incidentId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "safeMessage": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "retryable",
    "retryAt",
    "incidentId",
    "safeMessage"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:SourceError"
}
