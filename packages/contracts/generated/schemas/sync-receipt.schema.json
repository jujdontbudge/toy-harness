{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "sourceId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "incremental",
        "reconcile",
        "backfill"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "checkpointed",
        "blocked",
        "failed"
      ]
    },
    "observationIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 36,
        "maxLength": 36,
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "inserted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unchanged": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tombstones": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "quarantined": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "moreWork": {
      "type": "boolean"
    },
    "checkedAt": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "api",
            "device_stream",
            "device_export",
            "imported_snapshot",
            "local_report_only",
            "partial",
            "unavailable"
          ]
        },
        "included": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "capability": {
                "type": "string"
              },
              "reasonCode": {
                "type": "string"
              }
            },
            "required": [
              "capability",
              "reasonCode"
            ],
            "additionalProperties": false
          }
        },
        "historicalFrom": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 24,
              "maxLength": 24,
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "historicalThrough": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 24,
              "maxLength": 24,
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "historyComplete": {
          "type": "boolean"
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "partition": {
                "type": "string"
              },
              "from": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 24,
                    "maxLength": 24,
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "through": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 24,
                    "maxLength": 24,
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reasonCode": {
                "type": "string"
              }
            },
            "required": [
              "partition",
              "from",
              "through",
              "reasonCode"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "mode",
        "included",
        "excluded",
        "historicalFrom",
        "historicalThrough",
        "historyComplete",
        "gaps"
      ],
      "additionalProperties": false
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "AUTH_REQUIRED",
                "CONSENT_REQUIRED",
                "POLICY_BLOCKED",
                "OS_PERMISSION_REQUIRED",
                "ACCOUNT_MISMATCH",
                "CURSOR_EXPIRED",
                "RATE_LIMITED",
                "QUOTA_EXHAUSTED",
                "PAYMENT_REQUIRED",
                "NETWORK_UNAVAILABLE",
                "PROVIDER_UNAVAILABLE",
                "SCHEMA_CHANGED",
                "MALFORMED_ITEM",
                "COVERAGE_INCOMPLETE",
                "STORAGE_PRESSURE",
                "LEASE_LOST",
                "IDENTITY_CONFLICT",
                "INVALID_INPUT"
              ]
            },
            "retryable": {
              "type": "boolean"
            },
            "retryAt": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 24,
                  "maxLength": 24,
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "incidentId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 36,
                  "maxLength": 36,
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "safeMessage": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "retryable",
            "retryAt",
            "incidentId",
            "safeMessage"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "runId",
    "sourceId",
    "mode",
    "status",
    "observationIds",
    "inserted",
    "unchanged",
    "tombstones",
    "quarantined",
    "moreWork",
    "checkedAt",
    "coverage",
    "error"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:SyncReceipt"
}
