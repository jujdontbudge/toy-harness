{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "toy.hermes-httpx-auth-fixture.v1"
    },
    "operation": {
      "type": "string",
      "enum": [
        "add",
        "list",
        "chat",
        "priority",
        "remove",
        "reset"
      ]
    },
    "public_argv": {
      "minItems": 2,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "markers": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "AUTH_ADD_OK",
          "AUTH_ADD_NOT_CONFIRMED",
          "AUTH_SAVE_DENIED",
          "AUTH_SAVE_FAULT_NOT_CONFIRMED",
          "AUTH_LIST_READBACK_OK",
          "AUTH_LIST_EMPTY",
          "AUTH_LIST_NOT_CONFIRMED",
          "AUTH_PRIORITY_OK",
          "AUTH_PRIORITY_NOT_CONFIRMED",
          "CHAT_RESPONSE_OK",
          "CHAT_RESPONSE_NOT_CONFIRMED",
          "CHAT_GRANT_UNUSABLE",
          "CHAT_GRANT_USABILITY_NOT_CONFIRMED",
          "SIWC_AUTHORIZATION_REQUIRED",
          "SIWC_AUTHORIZATION_NOT_CONFIRMED",
          "CLI_EXIT_NONZERO",
          "CLI_EXCEPTION",
          "PUBLIC_STREAM_RESULT_INVALID",
          "AUTH_REMOVE_OK",
          "AUTH_RESET_OK",
          "AUTH_LIST_TARGET_RATE_LIMITED",
          "AUTH_PROVIDER_RATE_LIMIT_OBSERVED"
        ]
      }
    },
    "processIdentity": {
      "type": "object",
      "properties": {
        "pid": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "parentPid": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "gid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "pid",
        "parentPid",
        "uid",
        "gid"
      ],
      "additionalProperties": false
    },
    "observations": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "openai-codex",
            "openai-chatgpt"
          ]
        },
        "phase": {
          "type": "string",
          "enum": [
            "add",
            "list",
            "chat",
            "chat-expired",
            "chat-reloaded",
            "add-enospc",
            "add-replace-fault",
            "list-after-fault",
            "chat-after-fault",
            "siwc-unbound",
            "concurrent-refresh-add",
            "priority-added",
            "priority-restored",
            "remove",
            "reset"
          ]
        },
        "credential_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "target_label_present": {
          "type": "boolean"
        },
        "access_generation": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "initial",
                "rotated",
                "added",
                "added-rotated",
                "stale"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "catalog_access_generation": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "initial",
                "rotated",
                "added",
                "added-rotated",
                "stale"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "storage_fault_triggered": {
          "type": "boolean"
        },
        "token_hygiene": {
          "type": "boolean"
        },
        "success_claim_absent": {
          "type": "boolean"
        },
        "fallback_attempted": {
          "type": "boolean"
        },
        "network_denials": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "model-mismatch",
              "authorization-mismatch",
              "grant-mismatch",
              "paid-model-fallback",
              "device-grant-outside-add",
              "device-poll-outside-add",
              "model-request-outside-chat",
              "model-catalog-outside-chat",
              "codex-model-discovery",
              "openai-model-discovery",
              "unregistered-http",
              "tokenizer-download",
              "unregistered-socket"
            ]
          }
        },
        "socket_origin": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120,
              "pattern": "^[a-z_][a-z0-9_]*(?:\\.[a-z_][a-z0-9_]*)*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "provider",
        "phase",
        "access_generation",
        "catalog_access_generation",
        "storage_fault_triggered",
        "token_hygiene",
        "success_claim_absent",
        "fallback_attempted",
        "network_denials",
        "socket_origin"
      ],
      "additionalProperties": false
    },
    "concurrency": {
      "type": "object",
      "properties": {
        "order": {
          "type": "string",
          "enum": [
            "refresh-first",
            "add-first"
          ]
        },
        "actor": {
          "type": "string",
          "enum": [
            "auth-add",
            "expired-chat",
            "fresh-list-reload",
            "fresh-add-reload",
            "fresh-refresh-reload"
          ]
        },
        "barrier": {
          "type": "string",
          "enum": [
            "not-used",
            "reached",
            "released",
            "persisted"
          ]
        },
        "crashCut": {
          "type": "string",
          "enum": [
            "none",
            "after-add-public-command-before-wrapper-exit",
            "after-refresh-public-command-before-wrapper-exit"
          ]
        },
        "staleRefreshTokenRejected": {
          "type": "string",
          "enum": [
            "not-exercised",
            "rejected"
          ]
        },
        "staleRefreshResponse": {
          "type": "string",
          "enum": [
            "not-exercised",
            "rejected"
          ]
        },
        "freshProcessUse": {
          "type": "string",
          "enum": [
            "not-checked",
            "usable",
            "unusable"
          ]
        },
        "refreshGeneration": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "initial",
                "rotated",
                "added",
                "added-rotated",
                "stale"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "refreshEffects": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "enum": [
                  "initial",
                  "rotated",
                  "added"
                ]
              },
              "to": {
                "type": "string",
                "enum": [
                  "rotated",
                  "stale",
                  "added-rotated"
                ]
              },
              "barrier": {
                "type": "string",
                "enum": [
                  "primary-released",
                  "not-used"
                ]
              }
            },
            "required": [
              "from",
              "to",
              "barrier"
            ],
            "additionalProperties": false
          }
        },
        "refreshDispositions": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "expiredBeforeLock": {
                "type": "boolean"
              },
              "pairChangedAfterLock": {
                "type": "boolean"
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "refresh-invoked",
                  "reloaded-after-serialization"
                ]
              }
            },
            "required": [
              "expiredBeforeLock",
              "pairChangedAfterLock",
              "disposition"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "order",
        "actor",
        "barrier",
        "crashCut",
        "staleRefreshTokenRejected",
        "staleRefreshResponse",
        "freshProcessUse",
        "refreshGeneration",
        "refreshEffects",
        "refreshDispositions"
      ],
      "additionalProperties": false
    },
    "http_ledger": {
      "type": "object",
      "properties": {
        "device_code_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "device_code_polls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "token_exchanges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "token_refreshes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "model_catalog_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "model_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "denied_http_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "blocked_socket_events": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "required": [
        "device_code_requests",
        "device_code_polls",
        "token_exchanges",
        "token_refreshes",
        "model_catalog_requests",
        "model_requests",
        "denied_http_requests",
        "blocked_socket_events"
      ],
      "additionalProperties": false
    },
    "network_audit": {
      "type": "string",
      "const": "socket-audit-hook-installed"
    }
  },
  "required": [
    "schema",
    "operation",
    "public_argv",
    "exit_code",
    "markers",
    "processIdentity",
    "observations",
    "http_ledger",
    "network_audit"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:HermesAuthFixtureResultV1"
}
