{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "toy.research-skill-pin.v1"
    },
    "repository": {
      "type": "string",
      "const": "https://github.com/mattpocock/skills"
    },
    "sourcePath": {
      "type": "string",
      "const": "skills/engineering/research/SKILL.md"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}(?![\\s\\S])"
    },
    "contentDigest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "semanticVersion": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "resources": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "enum": [
              "LICENSE",
              "agents/openai.yaml"
            ]
          },
          "digest": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          }
        },
        "required": [
          "path",
          "digest"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "repository",
    "sourcePath",
    "sourceCommit",
    "contentDigest",
    "semanticVersion",
    "resources"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:ResearchSkillPinV1"
}
