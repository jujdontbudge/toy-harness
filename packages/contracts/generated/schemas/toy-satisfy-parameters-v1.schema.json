{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "toy.obligations.v1"
    },
    "request_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "dependency_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "expected_dependency_revision": {
      "type": "string",
      "maxLength": 19,
      "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "evidence": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "observationRef": {
            "type": "string",
            "minLength": 55,
            "maxLength": 55,
            "pattern": "^life:\\/\\/observation\\/([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "documentId": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "byteFrom": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
          },
          "byteTo": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
          },
          "quote": {
            "type": "string"
          }
        },
        "required": [
          "observationRef"
        ],
        "additionalProperties": false,
        "dependentRequired": {
          "byteFrom": [
            "byteTo",
            "documentId"
          ],
          "byteTo": [
            "byteFrom",
            "documentId"
          ]
        }
      }
    }
  },
  "required": [
    "schema_version",
    "request_key",
    "dependency_id",
    "expected_dependency_revision",
    "evidence"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:ToySatisfyParametersV1"
}
