{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "itemId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "itemRevision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "commitmentId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "commitmentRevision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "deadlineAt": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "fireAt": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 24,
        "maxLength": 24,
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
      }
    },
    "expiresAt": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "quietEpoch": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "mode": {
      "type": "string",
      "enum": [
        "local_notification",
        "alarmkit"
      ]
    },
    "desiredState": {
      "type": "string",
      "enum": [
        "armed",
        "canceled"
      ]
    },
    "deviceState": {
      "type": "string",
      "enum": [
        "pending",
        "armed",
        "cancellation_pending",
        "canceled",
        "permission_denied",
        "unsupported",
        "error",
        "expired"
      ]
    },
    "lastDeviceReceiptAt": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reasonCode": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "links": {
      "type": "object",
      "properties": {
        "recordRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "id": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "required": [
              "module",
              "kind",
              "id"
            ],
            "additionalProperties": false
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "observationRef": {
                "type": "string",
                "minLength": 55,
                "maxLength": 55,
                "pattern": "^life:\\/\\/observation\\/([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "documentId": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "byteFrom": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
              },
              "byteTo": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
              },
              "quote": {
                "type": "string"
              }
            },
            "required": [
              "observationRef"
            ],
            "additionalProperties": false
          }
        },
        "artifactDigests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          }
        }
      },
      "required": [
        "recordRefs",
        "observations",
        "artifactDigests"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "itemId",
    "itemRevision",
    "commitmentId",
    "commitmentRevision",
    "deadlineAt",
    "fireAt",
    "expiresAt",
    "generation",
    "quietEpoch",
    "mode",
    "desiredState",
    "deviceState",
    "lastDeviceReceiptAt",
    "reasonCode",
    "links"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:AttentionLocalPlanViewV1"
}
