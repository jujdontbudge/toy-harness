{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "order": {
      "type": "string",
      "enum": [
        "refresh-first",
        "add-first"
      ]
    },
    "actor": {
      "type": "string",
      "enum": [
        "auth-add",
        "expired-chat",
        "fresh-list-reload",
        "fresh-add-reload",
        "fresh-refresh-reload"
      ]
    },
    "barrier": {
      "type": "string",
      "enum": [
        "not-used",
        "reached",
        "released",
        "persisted"
      ]
    },
    "crashCut": {
      "type": "string",
      "enum": [
        "none",
        "after-add-public-command-before-wrapper-exit",
        "after-refresh-public-command-before-wrapper-exit"
      ]
    },
    "staleRefreshTokenRejected": {
      "type": "string",
      "enum": [
        "not-exercised",
        "rejected"
      ]
    },
    "staleRefreshResponse": {
      "type": "string",
      "enum": [
        "not-exercised",
        "rejected"
      ]
    },
    "freshProcessUse": {
      "type": "string",
      "enum": [
        "not-checked",
        "usable",
        "unusable"
      ]
    },
    "refreshGeneration": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "initial",
            "rotated",
            "added",
            "added-rotated",
            "stale"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "refreshEffects": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "enum": [
              "initial",
              "rotated",
              "added"
            ]
          },
          "to": {
            "type": "string",
            "enum": [
              "rotated",
              "stale",
              "added-rotated"
            ]
          },
          "barrier": {
            "type": "string",
            "enum": [
              "primary-released",
              "not-used"
            ]
          }
        },
        "required": [
          "from",
          "to",
          "barrier"
        ],
        "additionalProperties": false
      }
    },
    "refreshDispositions": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "expiredBeforeLock": {
            "type": "boolean"
          },
          "pairChangedAfterLock": {
            "type": "boolean"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "refresh-invoked",
              "reloaded-after-serialization"
            ]
          }
        },
        "required": [
          "expiredBeforeLock",
          "pairChangedAfterLock",
          "disposition"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "order",
    "actor",
    "barrier",
    "crashCut",
    "staleRefreshTokenRejected",
    "staleRefreshResponse",
    "freshProcessUse",
    "refreshGeneration",
    "refreshEffects",
    "refreshDispositions"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:HermesAuthConcurrencyObservationV1"
}
