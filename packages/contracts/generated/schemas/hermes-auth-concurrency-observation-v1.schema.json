{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "order": {
      "type": "string",
      "enum": [
        "refresh-first",
        "add-first"
      ]
    },
    "actor": {
      "type": "string",
      "enum": [
        "auth-add",
        "expired-chat",
        "fresh-list-reload",
        "fresh-add-reload",
        "fresh-refresh-reload"
      ]
    },
    "barrier": {
      "type": "string",
      "enum": [
        "not-used",
        "reached",
        "released",
        "persisted"
      ]
    },
    "crashCut": {
      "type": "string",
      "enum": [
        "none",
        "after-add-public-command-before-wrapper-exit",
        "after-refresh-public-command-before-wrapper-exit"
      ]
    },
    "staleRefreshTokenRejected": {
      "type": "string",
      "enum": [
        "not-exercised",
        "rejected"
      ]
    },
    "staleRefreshResponse": {
      "type": "string",
      "enum": [
        "not-exercised",
        "rejected"
      ]
    },
    "freshProcessUse": {
      "type": "string",
      "enum": [
        "not-checked",
        "usable",
        "unusable"
      ]
    },
    "refreshGeneration": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "initial",
            "rotated",
            "added",
            "added-rotated",
            "stale"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "order",
    "actor",
    "barrier",
    "crashCut",
    "staleRefreshTokenRejected",
    "staleRefreshResponse",
    "freshProcessUse",
    "refreshGeneration"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:HermesAuthConcurrencyObservationV1"
}
