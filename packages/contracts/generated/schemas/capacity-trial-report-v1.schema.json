{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "arm": {
      "type": "object",
      "properties": {
        "armId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "requestId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "jobKey": {
          "type": "string",
          "const": "capacity.full-review"
        },
        "anchor": {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        "designation": {
          "type": "string",
          "enum": [
            "original",
            "experimental"
          ]
        },
        "aiEverySeconds": {
          "anyOf": [
            {
              "type": "number",
              "const": 180
            },
            {
              "type": "number",
              "const": 900
            }
          ]
        },
        "clock": {
          "type": "string",
          "const": "fake_model"
        },
        "policyDigest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "configurationDigest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "routeDigest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "hostDigest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "workloadDigest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "armId",
        "requestId",
        "jobKey",
        "anchor",
        "designation",
        "aiEverySeconds",
        "clock",
        "policyDigest",
        "configurationDigest",
        "routeDigest",
        "hostDigest",
        "workloadDigest"
      ],
      "additionalProperties": false
    },
    "endsAt": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "denominator": {
      "type": "number",
      "const": 3360
    },
    "cadenceSeconds": {
      "type": "number",
      "const": 180
    },
    "totalSlots": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3360
    },
    "sequenceIntact": {
      "type": "boolean"
    },
    "firstSlotAt": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastSlotAt": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "counts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "scheduled",
          "running",
          "swept",
          "reviewed",
          "deferred_quota",
          "deferred_auth",
          "deferred_network",
          "deferred_busy",
          "maintenance",
          "failed",
          "missed",
          "coalesced_after_outage"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 3360
      },
      "required": [
        "scheduled",
        "running",
        "swept",
        "reviewed",
        "deferred_quota",
        "deferred_auth",
        "deferred_network",
        "deferred_busy",
        "maintenance",
        "failed",
        "missed",
        "coalesced_after_outage"
      ]
    },
    "reasons": {
      "maxItems": 3360,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3360
          }
        },
        "required": [
          "reason",
          "count"
        ],
        "additionalProperties": false
      }
    },
    "acceptanceComplete": {
      "type": "boolean",
      "const": false
    },
    "fullCadenceVerdict": {
      "type": "string",
      "const": "NOT_EVALUATED"
    }
  },
  "required": [
    "arm",
    "endsAt",
    "denominator",
    "cadenceSeconds",
    "totalSlots",
    "sequenceIntact",
    "firstSlotAt",
    "lastSlotAt",
    "counts",
    "reasons",
    "acceptanceComplete",
    "fullCadenceVerdict"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:CapacityTrialReportV1"
}
