{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "pattern": "^9\\.(?:[1-9]|[1-3][0-9]|4[0-8])(?![\\s\\S])"
    },
    "sourceLine": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "sectionDigest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "componentIds": {
      "maxItems": 66,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^D[0-9]{2}(?![\\s\\S])"
      }
    }
  },
  "required": [
    "section",
    "sourceLine",
    "title",
    "sectionDigest",
    "componentIds"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:ResearchCatalogSectionV1"
}
