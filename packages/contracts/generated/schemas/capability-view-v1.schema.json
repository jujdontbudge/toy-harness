{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "enum": [
        "control.help",
        "control.version",
        "control.status",
        "control.research.check",
        "control.bootstrap.identities",
        "control.doctor",
        "control.capture",
        "control.due",
        "control.obligations.show",
        "control.obligations.resolve",
        "control.obligations.defer",
        "control.obligations.satisfy",
        "control.attention.snapshot",
        "control.attention.preview",
        "control.attention.simulate-ack",
        "control.authority.pending",
        "control.authority.outbox",
        "control.authority.status",
        "control.authority.receipts",
        "control.authority.review",
        "control.sources.health",
        "control.sources.sync.now",
        "control.sources.cursor",
        "control.life.search",
        "control.life.timeline",
        "control.life.get",
        "control.review.slots",
        "control.review.runs",
        "control.review.verdicts",
        "control.review.request",
        "control.trace",
        "control.evidence",
        "control.replay",
        "control.sim.run",
        "control.sim.suite",
        "control.sim.show",
        "control.hands.status",
        "control.hands.smoke",
        "control.clock.show",
        "control.clock.freeze",
        "control.clock.advance",
        "control.clock.resume",
        "control.stack.up",
        "control.stack.down",
        "control.probe.run",
        "control.probe.show",
        "control.new.connector",
        "control.new.tool",
        "control.new.skill",
        "control.new.migration",
        "control.feature-map.check",
        "control.feature-map.update",
        "control.gardener.run",
        "control.release.status",
        "control.release.rollback"
      ]
    },
    "firstRelease": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ]
    },
    "required": {
      "type": "boolean"
    },
    "implementation": {
      "type": "string",
      "enum": [
        "specified",
        "built",
        "retired"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "DEFERRED_CAPABILITY",
        "NOT_IMPLEMENTED"
      ]
    },
    "tested": {
      "type": "boolean"
    },
    "installed": {
      "type": "boolean"
    },
    "deployed": {
      "type": "boolean"
    },
    "checkedAt": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "prerequisite": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "links": {
      "type": "object",
      "properties": {
        "recordRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "id": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "required": [
              "module",
              "kind",
              "id"
            ],
            "additionalProperties": false
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "observationRef": {
                "type": "string",
                "minLength": 55,
                "maxLength": 55,
                "pattern": "^life:\\/\\/observation\\/([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "documentId": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "byteFrom": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
              },
              "byteTo": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
              },
              "quote": {
                "type": "string"
              }
            },
            "required": [
              "observationRef"
            ],
            "additionalProperties": false
          }
        },
        "artifactDigests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          }
        }
      },
      "required": [
        "recordRefs",
        "observations",
        "artifactDigests"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "firstRelease",
    "required",
    "implementation",
    "state",
    "tested",
    "installed",
    "deployed",
    "checkedAt",
    "prerequisite",
    "links"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:CapabilityViewV1"
}
