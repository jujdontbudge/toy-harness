{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "criterionIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "capabilityId": {
      "type": [
        "string",
        "null"
      ]
    },
    "authorityClass": {
      "type": "string"
    },
    "executableNow": {
      "type": "boolean"
    },
    "dependencyId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "criterionIds",
    "description",
    "capabilityId",
    "authorityClass",
    "executableNow",
    "dependencyId"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:RemainingActionV1"
}
