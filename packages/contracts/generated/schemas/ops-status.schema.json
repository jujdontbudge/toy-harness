{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "generatedAt": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "postgres",
              "backend",
              "workers",
              "hermes",
              "hermes-interactive",
              "ops",
              "authority",
              "ingress",
              "approval",
              "review",
              "attention-delivery",
              "hands",
              "backup",
              "secrets",
              "publisher",
              "evaluator",
              "repair",
              "tailscale",
              "recorder"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "ready",
              "degraded",
              "starting",
              "parked",
              "unavailable",
              "unknown"
            ]
          },
          "launchdDomain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "launchdLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "uid": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "pid": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "bootId": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "releaseId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "checkedAt": {
            "type": "string",
            "minLength": 24,
            "maxLength": 24,
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
          },
          "lastProgressAt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 24,
                "maxLength": 24,
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reasonCode": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "state",
          "launchdDomain",
          "launchdLabel",
          "uid",
          "pid",
          "bootId",
          "releaseId",
          "checkedAt",
          "lastProgressAt",
          "reasonCode"
        ],
        "additionalProperties": false
      }
    },
    "backups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string",
            "enum": [
              "external",
              "b2"
            ]
          },
          "lastCompleteSetId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "lastCompleteAt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 24,
                "maxLength": 24,
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "criticalStateAgeSeconds": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "fullStateAgeSeconds": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "lastVerifiedRestoreAt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 24,
                "maxLength": 24,
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "healthy",
              "stale",
              "missing",
              "blocked",
              "unknown"
            ]
          }
        },
        "required": [
          "destination",
          "lastCompleteSetId",
          "lastCompleteAt",
          "criticalStateAgeSeconds",
          "fullStateAgeSeconds",
          "lastVerifiedRestoreAt",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "subscriptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "openai",
              "anthropic"
            ]
          },
          "source": {
            "type": "string",
            "maxLength": 2000
          },
          "fetchedAt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 24,
                "maxLength": 24,
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "known",
              "stale",
              "unavailable"
            ]
          },
          "windows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "limitId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "windowDurationMins": {
                  "anyOf": [
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "usedPercent": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "resetsAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 24,
                      "maxLength": 24,
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "limitId",
                "label",
                "windowDurationMins",
                "usedPercent",
                "resetsAt"
              ],
              "additionalProperties": false
            }
          },
          "paidUsageAllowed": {
            "type": "boolean",
            "const": false
          },
          "noOverageVerifiedAt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 24,
                "maxLength": 24,
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "provider",
          "source",
          "fetchedAt",
          "state",
          "windows",
          "paidUsageAllowed",
          "noOverageVerifiedAt"
        ],
        "additionalProperties": false
      }
    },
    "currentRelease": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "rollbackRelease": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "diskAvailableBytes": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "memoryPressure": {
      "type": "string",
      "enum": [
        "normal",
        "warning",
        "critical",
        "unknown"
      ]
    },
    "reviewSlots": {
      "type": "object",
      "properties": {
        "periodStart": {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        "scheduled": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "admitted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inferenceDone": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deferred": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "periodStart",
        "scheduled",
        "admitted",
        "inferenceDone",
        "reviewed",
        "deferred",
        "missed"
      ],
      "additionalProperties": false
    },
    "incidentIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 36,
        "maxLength": 36,
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    }
  },
  "required": [
    "generatedAt",
    "services",
    "backups",
    "subscriptions",
    "currentRelease",
    "rollbackRelease",
    "diskAvailableBytes",
    "memoryPressure",
    "reviewSlots",
    "incidentIds"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:OpsStatus"
}
