{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "not_applicable",
        "pending",
        "confirmed"
      ]
    },
    "quietEpoch": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "planGeneration": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "pendingPlanRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "id": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "module",
          "kind",
          "id"
        ],
        "additionalProperties": false
      }
    },
    "confirmedPlanRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "id": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "module",
          "kind",
          "id"
        ],
        "additionalProperties": false
      }
    },
    "residualOfflineRisk": {
      "type": "boolean"
    },
    "checkedAt": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    }
  },
  "required": [
    "state",
    "quietEpoch",
    "planGeneration",
    "pendingPlanRefs",
    "confirmedPlanRefs",
    "residualOfflineRisk",
    "checkedAt"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:AttentionLocalCancellationV1"
}
