{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "principalId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "profile": {
          "type": "string",
          "const": "toy"
        },
        "sessionId": {
          "type": "string"
        },
        "taskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "contractId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "contractVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "generation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
        }
      },
      "required": [
        "runId",
        "principalId",
        "profile",
        "sessionId",
        "taskId",
        "turnId",
        "contractId",
        "contractVersion",
        "generation"
      ],
      "additionalProperties": false
    },
    "payloadHash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "scheduledSlot": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "jobKey": {
              "type": "string"
            },
            "slotAt": {
              "type": "string",
              "minLength": 24,
              "maxLength": 24,
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
            }
          },
          "required": [
            "jobKey",
            "slotAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "slotState": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "scheduled",
            "running",
            "swept",
            "reviewed",
            "deferred_quota",
            "deferred_auth",
            "deferred_network",
            "deferred_busy",
            "maintenance",
            "failed",
            "missed",
            "coalesced_after_outage"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "pendingWork": {
      "type": "boolean"
    }
  },
  "required": [
    "run",
    "payloadHash",
    "scheduledSlot",
    "slotState",
    "pendingWork"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:AdmissionReadbackV1"
}
