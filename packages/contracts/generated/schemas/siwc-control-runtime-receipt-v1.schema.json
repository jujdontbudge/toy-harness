{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "uid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "euid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "gid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "egid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "groups": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "moduleImported": {
      "type": "boolean"
    },
    "keychainState": {
      "type": "string",
      "enum": [
        "not_called",
        "absent",
        "present",
        "unavailable"
      ]
    },
    "helperExitCode": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "helperTerminated": {
      "type": "boolean"
    }
  },
  "required": [
    "requestId",
    "uid",
    "euid",
    "gid",
    "egid",
    "groups",
    "moduleImported",
    "keychainState",
    "helperExitCode",
    "helperTerminated"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:SiwcControlRuntimeReceiptV1"
}
