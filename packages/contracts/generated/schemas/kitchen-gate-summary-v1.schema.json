{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "passed"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*(?![\\s\\S])"
    },
    "attemptEvidence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*(?![\\s\\S])"
    },
    "acceptanceComplete": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "verdict",
    "checks",
    "evidence",
    "acceptanceComplete"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:KitchenGateSummaryV1"
}
