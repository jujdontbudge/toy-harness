{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "module": {
      "type": "string",
      "enum": [
        "contracts",
        "obligations",
        "attention",
        "authority",
        "sources",
        "lifestore",
        "hermes",
        "client",
        "hands",
        "self-improvement",
        "adhd",
        "ops"
      ]
    },
    "code": {
      "type": "string",
      "enum": [
        "INVALID_INPUT",
        "TEST_ONLY",
        "UNAUTHORIZED",
        "NOT_IMPLEMENTED",
        "DEPENDENCY_UNAVAILABLE",
        "ATTESTATION_INVALID",
        "INTERNAL_ERROR",
        "OUTPUT_INVALID",
        "CONFLICT",
        "MEMORY_PRESSURE",
        "DISK_PRESSURE",
        "SECRET_UNAVAILABLE",
        "SECRET_REVOKED",
        "BACKUP_DESTINATION_MISSING",
        "BACKUP_INCOMPLETE",
        "INCOMPATIBLE_SCHEMA",
        "ARTIFACT_MISMATCH",
        "TIMEOUT"
      ]
    },
    "message": {
      "type": "string",
      "enum": [
        "The invocation does not match the registered command schema.",
        "This command requires a named disposable test environment.",
        "The calling identity is not authorized for this operation.",
        "The registered owner operation is not implemented.",
        "The required installed owner or launcher is unavailable.",
        "The environment attestation is missing or invalid.",
        "The command could not produce a valid result.",
        "The owner response did not match the registered output schema.",
        "The request conflicts with the recorded operation or artifact.",
        "Measured memory admission does not permit this operation.",
        "Measured disk admission does not permit this operation.",
        "The required secret is unavailable to the authorized owner.",
        "The required secret has been revoked.",
        "The registered backup destination is unavailable.",
        "The required backup evidence is incomplete.",
        "The installed schema is incompatible with this operation.",
        "The required artifact does not match its recorded identity.",
        "The bounded owner operation timed out; reconcile its recorded state."
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "retryAt": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "effectState": {
      "type": "string",
      "enum": [
        "none",
        "confirmed",
        "unknown"
      ]
    },
    "currentRevision": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "currentGeneration": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "operationRef": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "module",
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "requiredInteraction": {
      "type": "null"
    },
    "incidentId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    }
  },
  "required": [
    "module",
    "code",
    "message",
    "retryable",
    "retryAt",
    "effectState",
    "currentRevision",
    "currentGeneration",
    "operationRef",
    "requiredInteraction"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:CliError"
}
