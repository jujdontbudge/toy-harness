{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "pattern": "^9\\.(?:[1-9]|[1-3][0-9]|4[0-8])(?![\\s\\S])"
    },
    "memberKind": {
      "type": "string",
      "enum": [
        "canonical_component",
        "named_provider"
      ]
    },
    "memberName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "sourceLine": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "sourceText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "sourceDigest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "componentId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^D[0-9]{2}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "registerSourceLine": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "registerRowDigest": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "relationship": {
      "type": "string",
      "enum": [
        "canonical_consuming_spec",
        "explicit_catalog_crosswalk",
        "canonical_cross_reference",
        "superseded_catalog_reference",
        "unmapped"
      ]
    },
    "routeState": {
      "type": "string",
      "enum": [
        "pending",
        "optional_pending",
        "blocked",
        "unselected",
        "partial",
        "superseded"
      ]
    },
    "routeEvidence": {
      "type": "string",
      "maxLength": 16000
    },
    "activationVerified": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "section",
    "memberKind",
    "memberName",
    "sourceLine",
    "sourceText",
    "sourceDigest",
    "componentId",
    "registerSourceLine",
    "registerRowDigest",
    "relationship",
    "routeState",
    "routeEvidence",
    "activationVerified"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:ResearchCatalogMemberV1"
}
