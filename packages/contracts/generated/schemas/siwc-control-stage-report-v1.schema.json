{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "toy.siwc-control-stage-report.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "observedAt": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "operation": {
      "type": "string",
      "enum": [
        "prepare",
        "stage",
        "verify"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "prepared",
        "staged",
        "verified",
        "blocked"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "ARTIFACT_PREPARED",
        "ROOT_ARTIFACT_STAGED",
        "ROOT_ARTIFACT_VERIFIED",
        "ROOT_CALLER_REQUIRED",
        "ARTIFACT_UNAVAILABLE"
      ]
    },
    "artifactDigest": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "fileCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12000
    },
    "bytes": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)(?![\\s\\S])"
    },
    "callerUid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "controlUid": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "controlGid": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "finalPath": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "bootstrapReceiptDigest": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "relocationVerified": {
      "type": "boolean"
    },
    "ownershipVerified": {
      "type": "boolean"
    },
    "preservedPartialStage": {
      "type": "boolean"
    },
    "currentPointerChanged": {
      "type": "boolean",
      "const": false
    },
    "servicesActivated": {
      "type": "boolean",
      "const": false
    },
    "keychainCalled": {
      "type": "boolean",
      "const": false
    },
    "liveProviderSends": {
      "type": "number",
      "const": 0
    },
    "acceptanceComplete": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "observedAt",
    "operation",
    "state",
    "reason",
    "artifactDigest",
    "fileCount",
    "bytes",
    "callerUid",
    "controlUid",
    "controlGid",
    "finalPath",
    "bootstrapReceiptDigest",
    "relocationVerified",
    "ownershipVerified",
    "preservedPartialStage",
    "currentPointerChanged",
    "servicesActivated",
    "keychainCalled",
    "liveProviderSends",
    "acceptanceComplete"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:SiwcControlStageReportV1"
}
