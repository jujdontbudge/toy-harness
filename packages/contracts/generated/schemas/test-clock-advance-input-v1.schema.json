{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "by": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^P(?=\\d|T\\d)(?:\\d+D)?(?:T(?=\\d)(?:\\d+H)?(?:\\d+M)?(?:\\d+(?:\\.\\d{1,3})?S)?)?(?![\\s\\S])"
    },
    "requestId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "waitMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120000
    }
  },
  "required": [
    "by",
    "requestId",
    "waitMs"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:TestClockAdvanceInputV1"
}
