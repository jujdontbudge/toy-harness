                  "bucketId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "durationMinutes": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "usedPercent": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "resetAt": {
