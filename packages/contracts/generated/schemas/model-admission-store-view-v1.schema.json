        "accountRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "utcDay": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "policyDigest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "ready": {
          "type": "boolean"
        },
        "restoredUnreconciled": {
          "type": "boolean"
        },
        "providerLeaseActive": {
          "type": "boolean"
        },
        "foregroundWaiting": {
          "type": "boolean"
        },
        "fallbackJobsReserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unreflectedFiveHourUpperPercent": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "unreflectedWeeklyUpperPercent": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "accountRef",
        "utcDay",
        "policyDigest",
        "ready",
        "restoredUnreconciled",
        "providerLeaseActive",
        "foregroundWaiting",
        "fallbackJobsReserved",
        "unreflectedFiveHourUpperPercent",
        "unreflectedWeeklyUpperPercent"
      ],
      "additionalProperties": false
    },
