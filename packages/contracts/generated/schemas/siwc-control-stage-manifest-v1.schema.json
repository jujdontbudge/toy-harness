{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "toy.siwc-control-stage-manifest.v1"
    },
    "schemaDigest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "nodeVersion": {
      "type": "string",
      "const": "24.21.0"
    },
    "pythonVersion": {
      "type": "string",
      "const": "3.14.7"
    },
    "zodVersion": {
      "type": "string",
      "const": "4.6.5"
    },
    "sourceLockDigest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "entries": {
      "minItems": 1,
      "maxItems": 12000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "kind": {
            "type": "string",
            "enum": [
              "directory",
              "file",
              "link"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "0440",
              "0550"
            ]
          },
          "bytes": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)(?![\\s\\S])"
          },
          "digest": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "target": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "path",
          "kind",
          "mode",
          "bytes",
          "digest",
          "target"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "schemaDigest",
    "nodeVersion",
    "pythonVersion",
    "zodVersion",
    "sourceLockDigest",
    "entries"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:SiwcControlStageManifestV1"
}
