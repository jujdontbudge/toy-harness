{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestedRelease": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3",
            "R4",
            "R5"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "registerPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*(?![\\s\\S])"
    },
    "registerDigest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "components": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][0-9]{2}(?![\\s\\S])"
          },
          "sourceLine": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "rowDigest": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "componentAndPin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "consumingSpecs": {
            "type": "string",
            "maxLength": 16000
          },
          "researchReference": {
            "type": "string",
            "maxLength": 16000
          },
          "alternativesAndReason": {
            "type": "string",
            "maxLength": 16000
          },
          "releaseGate": {
            "type": "string",
            "maxLength": 16000
          },
          "missingPinDeclared": {
            "type": "boolean"
          },
          "reportKeys": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 10
            }
          },
          "certification": {
            "type": "string",
            "const": "UNVERIFIED"
          }
        },
        "required": [
          "id",
          "sourceLine",
          "rowDigest",
          "componentAndPin",
          "consumingSpecs",
          "researchReference",
          "alternativesAndReason",
          "releaseGate",
          "missingPinDeclared",
          "reportKeys",
          "certification"
        ],
        "additionalProperties": false
      }
    },
    "reports": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 10
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*(?![\\s\\S])"
          },
          "listedSections": {
            "type": "string",
            "maxLength": 16000
          },
          "digest": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key",
          "path",
          "listedSections",
          "digest"
        ],
        "additionalProperties": false
      }
    },
    "specReferences": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*(?![\\s\\S])"
          },
          "digest": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "componentReferences": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[ABNCEDM][0-9]{2}(?![\\s\\S])"
                },
                "sourceLines": {
                  "minItems": 1,
                  "maxItems": 16000,
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              },
              "required": [
                "id",
                "sourceLines"
              ],
              "additionalProperties": false
            }
          },
          "requirementMappingRows": {
            "maxItems": 2000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceLine": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "rowDigest": {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64,
                  "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                },
                "requirementCell": {
                  "type": "string",
                  "maxLength": 16000
                }
              },
              "required": [
                "sourceLine",
                "rowDigest",
                "requirementCell"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "path",
          "digest",
          "componentReferences",
          "requirementMappingRows"
        ],
        "additionalProperties": false
      }
    },
    "dependencyClosureVerified": {
      "type": "boolean",
      "const": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "componentId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z][0-9]{2}(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "PIN_MISSING",
              "CONSUMING_SPECS_MISSING",
              "RESEARCH_CHOICE_OPEN",
              "RESEARCH_REFERENCE_MISSING",
              "REPORT_MISSING",
              "DECISION_MISSING",
              "GATE_MISSING",
              "GATE_EVIDENCE_UNVERIFIED",
              "RESEARCH_ATTESTATION_UNVERIFIED",
              "DEPENDENCY_CLOSURE_UNVERIFIED",
              "COMPONENT_REFERENCE_UNMAPPED"
            ]
          },
          "sourceLine": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*(?![\\s\\S])"
          }
        },
        "required": [
          "componentId",
          "code",
          "sourceLine"
        ],
        "additionalProperties": false
      }
    },
    "scope": {
      "type": "string",
      "const": "register_inventory"
    },
    "admission": {
      "type": "string",
      "const": "BLOCKED"
    },
    "acceptanceComplete": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "requestedRelease",
    "registerPath",
    "registerDigest",
    "components",
    "reports",
    "specReferences",
    "dependencyClosureVerified",
    "findings",
    "scope",
    "admission",
    "acceptanceComplete"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:ResearchRegisterInspectionV1"
}
