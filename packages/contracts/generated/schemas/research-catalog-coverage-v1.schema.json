{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "catalogPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*(?![\\s\\S])"
    },
    "catalogDigest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "contractPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*(?![\\s\\S])"
    },
    "contractDigest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "supersessionLine": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "supersessionText": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersessionDigest": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "sections": {
      "maxItems": 48,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string",
            "pattern": "^9\\.(?:[1-9]|[1-3][0-9]|4[0-8])(?![\\s\\S])"
          },
          "sourceLine": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "sectionDigest": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "componentIds": {
            "maxItems": 66,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^D[0-9]{2}(?![\\s\\S])"
            }
          }
        },
        "required": [
          "section",
          "sourceLine",
          "title",
          "sectionDigest",
          "componentIds"
        ],
        "additionalProperties": false
      }
    },
    "members": {
      "maxItems": 300,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string",
            "pattern": "^9\\.(?:[1-9]|[1-3][0-9]|4[0-8])(?![\\s\\S])"
          },
          "memberKind": {
            "type": "string",
            "enum": [
              "canonical_component",
              "named_provider"
            ]
          },
          "memberName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "sourceLine": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "sourceText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "sourceDigest": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "componentId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^D[0-9]{2}(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "registerSourceLine": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "registerRowDigest": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "relationship": {
            "type": "string",
            "enum": [
              "canonical_consuming_spec",
              "explicit_catalog_crosswalk",
              "canonical_cross_reference",
              "superseded_catalog_reference",
              "unmapped"
            ]
          },
          "routeState": {
            "type": "string",
            "enum": [
              "pending",
              "optional_pending",
              "blocked",
              "unselected",
              "partial",
              "superseded"
            ]
          },
          "routeEvidence": {
            "type": "string",
            "maxLength": 16000
          },
          "activationVerified": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "section",
          "memberKind",
          "memberName",
          "sourceLine",
          "sourceText",
          "sourceDigest",
          "componentId",
          "registerSourceLine",
          "registerRowDigest",
          "relationship",
          "routeState",
          "routeEvidence",
          "activationVerified"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "SECTION_MISSING",
              "SECTION_DUPLICATE",
              "SECTION_UNMAPPED",
              "REGISTER_SECTION_MISSING",
              "REGISTER_COMPONENT_MISSING",
              "REGISTER_COMPONENT_OUT_OF_RANGE",
              "LONG_TAIL_MEMBER_UNMAPPED",
              "CATALOG_MEMBER_DETAIL_OPEN",
              "SUPERSESSION_REGISTER_CONFLICT",
              "SUPERSESSION_DECISION_MISSING"
            ]
          },
          "section": {
            "type": [
              "string",
              "null"
            ]
          },
          "memberName": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceLine": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "componentId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^D[0-9]{2}(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "registerSourceLine": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "code",
          "section",
          "memberName",
          "sourceLine",
          "componentId",
          "registerSourceLine",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "sectionMappingComplete": {
      "type": "boolean"
    },
    "memberMappingComplete": {
      "type": "boolean"
    },
    "registerRouteConsistent": {
      "type": "boolean"
    },
    "activationVerified": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "catalogPath",
    "catalogDigest",
    "contractPath",
    "contractDigest",
    "supersessionLine",
    "supersessionText",
    "supersessionDigest",
    "sections",
    "members",
    "findings",
    "sectionMappingComplete",
    "memberMappingComplete",
    "registerRouteConsistent",
    "activationVerified"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:ResearchCatalogCoverageV1"
}
