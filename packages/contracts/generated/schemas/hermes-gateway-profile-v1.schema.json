{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "gateway": {
      "type": "object",
      "properties": {
        "multiplex_profiles": {
          "type": "boolean"
        },
        "loop_watchdog": {
          "type": "boolean"
        },
        "loop_watchdog_probe_interval_s": {
          "type": "number",
          "minimum": 1,
          "maximum": 3600
        },
        "loop_watchdog_probe_timeout_s": {
          "type": "number",
          "minimum": 1,
          "maximum": 600
        },
        "loop_watchdog_max_strikes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "multiplex_profiles",
        "loop_watchdog",
        "loop_watchdog_probe_interval_s",
        "loop_watchdog_probe_timeout_s",
        "loop_watchdog_max_strikes"
      ],
      "additionalProperties": false
    },
    "platforms": {
      "type": "object",
      "properties": {
        "discord": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "discord"
      ],
      "additionalProperties": false
    },
    "streaming": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "gateway",
    "platforms",
    "streaming"
  ],
  "additionalProperties": false,
  "$id": "urn:toy:contracts:v1:HermesGatewayProfileV1"
}
